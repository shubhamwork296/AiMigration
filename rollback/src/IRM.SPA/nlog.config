<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="C:\inetpub\Q3Tech\ie\internal-nlog.txt">

  <!-- Load the ASP.NET Core plugin -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>
  <variable name="layout" value="${longdate}|${logger}|${uppercase:${level}}|${message} ${exception}" />
  <variable name="layouturl" value="${longdate}|${logger}|${uppercase:${level}}|${message} ${exception}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}" />
  <!-- the targets to write to -->
  <targets>
    <!-- write logs to file -->
    <target xsi:type="File" name="allLogs" fileName="D:\Logs\SchedularLog\nlog-all-${shortdate}.log" archiveAboveSize="50000000"
                layout="${layout}" />

    <!-- another file log, only own logs. Uses some ASP.NET core renderers -->
    <target xsi:type="File" name="infoLogs"  fileName="D:\Logs\SchedularLog\nlog-info-${shortdate}.log" archiveAboveSize="50000000"
            layout= "${layouturl}"/>

    <target xsi:type="File" name="errorLogs" fileName="D:\Logs\SchedularLog\nlog-error-${shortdate}.log"  archiveAboveSize="50000000"
			layout="${layout}"
          />

    <!-- write to the void aka just remove -->
    <target xsi:type="Null" name="blackhole" />
  </targets>

  <!-- rules to map from logger name to target -->
  <rules>
    <!--All logs, including from Microsoft-->
    <logger name="*" minlevel="Trace" writeTo="allLogs" />

    <!--Skip Microsoft logs and so log only own logs-->
    <logger name="Microsoft.*" minlevel="Trace" writeTo="blackhole" final="true" />
    <logger name="*" minlevel="Error" maxlevel="Error" writeTo="errorLogs" />
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="infoLogs" />
  </rules>
</nlog>